<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clínica</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar">
        <div class="navbar-brand">🏥 Sistema de Gestión de Clínica</div>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <nav class="navbar-links">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista") || User.IsInRole("Medico"))
                {
                    <a asp-controller="Pacientes" asp-action="Index">Pacientes</a>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                {
                    <a asp-controller="Medicos" asp-action="Index">Médicos</a>
                }
                <a asp-controller="Citas" asp-action="Index">Citas</a>
                <a asp-controller="HistorialMedico" asp-action="Index">Historial</a>
                <a asp-controller="Reportes" asp-action="Index">Reportes</a>
                <span class="navbar-user">👤 @User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                <a asp-controller="Account" asp-action="Logout" class="btn-logout">Cerrar sesión</a>
            </nav>
        }
    </header>

    <main class="container">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <p>Sistema de Gestión de Clínica &copy; 2026 - Programación III, UAPA</p>
    </footer>
</body>
</html>
