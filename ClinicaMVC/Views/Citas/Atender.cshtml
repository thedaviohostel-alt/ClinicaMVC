@model AtenderCitaViewModel
@{
    ViewData["Title"] = "Atender cita";
}
<div class="card" style="max-width:600px">
    <h2>Atender cita</h2>
    <p><strong>Paciente:</strong> @Model.NombrePaciente</p>
    <p><strong>Médico:</strong> @Model.NombreMedico</p>
    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy") &nbsp; <strong>Hora:</strong> @Model.Hora.ToString("hh\\:mm")</p>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Atender" asp-route-id="@Model.IdCita" method="post">
        <input type="hidden" asp-for="IdCita" />
        <div class="form-group">
            <label asp-for="Sintomas"></label>
            <textarea asp-for="Sintomas" rows="3"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="Diagnostico"></label>
            <textarea asp-for="Diagnostico" rows="3"></textarea>
            <span asp-validation-for="Diagnostico" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Tratamiento"></label>
            <textarea asp-for="Tratamiento" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Guardar y marcar como Atendida</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
